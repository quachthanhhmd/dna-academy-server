[Unit]
Description=Restart DNA Academy containers that Docker marked unhealthy
Documentation=file:///root/srv/dna-academy/scripts/autoheal.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/root/srv/dna-academy/scripts/autoheal.sh
# Journald collects stdout; no log file to rotate.
StandardOutput=journal
StandardError=journal
