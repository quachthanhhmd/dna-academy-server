NODE_ENV=development
APP_PORT=3001
APP_NAME="NestJS API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
# Rate limiting on auth routes. Behind a load balancer set APP_TRUST_PROXY to
# the number of proxy hops (usually 1) or the proxies' addresses, or every
# client shares the balancer's IP. `true` is refused: it lets clients spoof IPs.
APP_TRUST_PROXY=
# Widens every per-IP limit (not the per-email ones). Raise it if many users
# share one address; the e2e env sets 100 because every request there comes
# from one machine.
RATE_LIMIT_IP_MULTIPLIER=1
# Epic 6 — locales the API will serve master data in. First-listed is not the
# default; the default is hard-coded to vi (see src/utils/i18n/locale.ts).
APP_SUPPORTED_LOCALES=vi,en
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=api
DATABASE_SYNCHRONIZE=false
# Must stay well below Postgres max_connections (100 by default). At 100 the
# pool alone could take every server slot, starving migrations, psql and any
# second client; at 20 excess queries queue in the pool instead of failing.
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
# Destination directory for FILE_DRIVER=local, relative to the working
# directory. Created on boot if missing.
FILE_LOCAL_PATH=./upload
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
# Where the e2e suite reaches maildev's web UI. `localhost` is right when the
# suite runs on the host (MAIL_HOST=maildev only resolves inside compose); set
# it to `maildev` to run the suite from inside the network.
MAIL_CLIENT_HOST=localhost
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

WORKER_HOST=redis://redis:6379/1

# Epic 4 v2.1 §2.4.1 — learning rules. Both are validated at boot: the
# threshold must be an integer 0-100, the word count an integer >= 1.
# QUIZ_PASS_THRESHOLD_DEFAULT only seeds new quizzes; changing it never
# rewrites a lecture_content_quiz row that already has a threshold.
QUIZ_PASS_THRESHOLD_DEFAULT=70
REFLECTION_MIN_WORDS=10
# Epic 4.6 D3 — minimum trimmed characters for a free-text career reflection answer.
CAREER_REFLECTION_MIN_CHARS=10

# Epic 4.1 §3.4 — printed on the certificate card and echoed by the public
# verification page. Validated at boot: the issuer must be a non-empty string
# and the signature must be a valid URL or left empty (empty draws a
# placeholder stroke instead of a broken image).
CERTIFICATE_ISSUER_NAME=DNA Learning Academy
CERTIFICATE_SIGNATURE_URL=
